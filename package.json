{
  "name": "ourcelium-gateway",
  "version": "0.1.0",
  "description": "Ourcelium API gateway",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.0.0",
    "@supabase/supabase-js": "^2.49.4",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "stripe": "^17.7.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.13",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.8.3"
  }
}
